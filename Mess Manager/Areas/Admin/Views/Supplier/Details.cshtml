@model Mess_Manager.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container-fluid py-2">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="bg-light rounded-3 p-3 mb-4">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Suppliers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.SupplierName</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Card Header -->
                <div class="card-header bg-primary text-white py-4 px-5">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h4 mb-1 fw-bold">
                                <i class="bi bi-building me-2"></i>Supplier Details
                            </h2>
                            <p class="mb-0 opacity-75">Complete information about the supplier</p>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm dropdown-toggle" type="button" id="actionsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear me-1"></i>Actions
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="actionsDropdown">
                                <li><a class="dropdown-item" asp-action="CreateOrEdit" asp-route-id="@Model.Id"><i class="bi bi-pencil-square me-2"></i>Edit Supplier</a></li>
                                <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="bi bi-trash3 me-2"></i>Delete Supplier</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-action="Index"><i class="bi bi-list-ul me-2"></i>View All Suppliers</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-5">
                    <div class="row mb-5">
                        <div class="col-md-8">
                            <h3 class="mb-3 text-primary">@Model.SupplierName</h3>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill">
                                    <i class="bi bi-building me-1"></i>Active Supplier
                                </span>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                    <i class="bi bi-check-circle me-1"></i>Verified
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Supplier Information -->
                    <div class="row g-4">
                        <!-- Contact Information -->
                        <div class="col-lg-6">
                            <div class="card h-100 border-0 bg-light-subtle rounded-3">
                                <div class="card-body">
                                    <h5 class="card-title mb-4 text-secondary">
                                        <i class="bi bi-telephone me-2"></i>Contact Information
                                    </h5>

                                    <div class="mb-4">
                                        <label class="form-label text-muted small mb-1">Phone Number</label>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-telephone-fill text-primary me-3"></i>
                                            <span class="fw-semibold fs-5">@Model.PhoneNumber</span>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-muted small mb-1">Email Address</label>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-envelope-fill text-primary me-3"></i>
                                            <span class="fw-semibold">@Model.Email</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Address Information -->
                        <div class="col-lg-6">
                            <div class="card h-100 border-0 bg-light-subtle rounded-3">
                                <div class="card-body">
                                    <h5 class="card-title mb-4 text-secondary">
                                        <i class="bi bi-geo-alt me-2"></i>Address Information
                                    </h5>

                                    <div>
                                        <label class="form-label text-muted small mb-2">Full Address</label>
                                        <div class="d-flex">
                                            <i class="bi bi-house-fill text-primary me-3 mt-1"></i>
                                            <p class="mb-0 fw-medium">@Model.Address</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information (Optional) -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-0 bg-light-subtle rounded-3">
                                <div class="card-body">
                                    <h5 class="card-title mb-4 text-secondary">
                                        <i class="bi bi-info-circle me-2"></i>Additional Details
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label text-muted small mb-1">Supplier ID</label>
                                            <div class="fw-semibold">#SUP-@Model.Id.ToString("D4")</div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label text-muted small mb-1">Created Date</label>
                                            <div class="fw-semibold">@DateTime.Now.ToString("MMMM dd, yyyy")</div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label text-muted small mb-1">Status</label>
                                            <div>
                                                <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Active
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-5">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center border-top pt-4">
                                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                    <i class="bi bi-arrow-left me-2"></i>Back to Suppliers
                                </a>
                                <div class="btn-group" role="group">
                                    <a asp-action="CreateOrEdit" asp-route-id="@Model.Id" class="btn btn-warning text-dark px-4 rounded-pill me-2">
                                        <i class="bi bi-pencil-square me-2"></i>Edit Supplier
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                                        <button type="submit" class="btn btn-danger px-4 rounded-pill">
                                            <i class="bi bi-trash3 me-2"></i> Delete
                                        </button>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Note -->
            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-shield-lock me-1"></i>
                    Supplier information is secured and confidential.
                    <span class="d-block mt-1">
                        © @DateTime.Now.Year Mess Manager System • v2.0
                    </span>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Optional: Add some custom CSS for better styling -->
<style>
    .card {
        transition: transform 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .badge {
        font-size: 0.85em;
    }

    .bg-light-subtle {
        background-color: #f8f9fa !important;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .breadcrumb {
        --bs-breadcrumb-divider: '›';
    }
</style>